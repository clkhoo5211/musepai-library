{
  "id": "b23_nan03",
  "title": "紙條仔的字 Tsuá-tiâu-á ê jī",
  "title_source": "scripted",
  "genre": "Taigi West Coast cool-jazz chamber ballad",
  "language": "nan",
  "language_name": "Taiwanese Hokkien (Taigi)",
